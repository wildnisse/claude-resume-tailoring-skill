{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wildnisse/claude-resume-tailoring-skill/schemas/ats-score.schema.json",
  "title": "ATS Score",
  "description": "Output of the ats-scorer agent. 100-point rubric across 5 dimensions. Keep it terse: assessments <=2 sentences, evidence <=25 words, whole file under ~6KB.",
  "type": "object",
  "required": ["candidate_name", "job_title", "company", "analysis_date", "independence", "echo_check", "scores", "total_score", "recommendation"],
  "additionalProperties": false,
  "properties": {
    "candidate_name": { "type": "string" },
    "job_title": { "type": "string" },
    "company": { "type": "string" },
    "analysis_date": { "type": "string", "format": "date-time" },
    "resume_version": {
      "type": "string",
      "description": "Which resume version was scored (e.g. 'vp-cto-full-content.json (master, untailored)' or 'joakim-monstad-director-v2')."
    },
    "independence": {
      "type": "boolean",
      "description": "True only if the scorer ran in a fresh context that never saw the tailoring conversation."
    },
    "independence_note": {
      "type": "string",
      "description": "Required when independence is false: what leaked."
    },
    "echo_check": {
      "description": "Round 2+: candidate-phrase/JD-phrase pairs found (incl. paraphrases), or the summary sentences and headers compared. Round 1: 'n/a: untailored master'.",
      "type": ["string", "array", "object"]
    },
    "lint_reconciliation": {
      "type": "string",
      "description": "One or two sentences reconciling with lint-report.json, when one exists."
    },
    "consistency_checks": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string" },
      "description": "Timeline/KB-mismatch/tenure findings, one line each. Empty array if clean."
    },
    "gap_questions": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string" },
      "description": "Round 1: targeted questions for the orchestrator to batch to the user."
    },
    "scores": {
      "type": "object",
      "required": ["formatting_structure", "tone_fit_alignment", "hard_requirements_match", "nice_to_haves_differentiation", "overall_fit_recommendation"],
      "properties": {
        "formatting_structure": {
          "type": "object",
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 20 },
            "assessment": { "type": "string", "description": "<=2 sentences. One sentence for the untailored master." }
          }
        },
        "tone_fit_alignment": {
          "type": "object",
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 20 },
            "raw_score": { "type": "integer", "minimum": 0, "maximum": 20 },
            "deductions": {
              "type": "array",
              "maxItems": 4,
              "items": { "type": "string" },
              "description": "Each applied penalty: name, points, one-line evidence."
            },
            "assessment": { "type": "string", "description": "<=2 sentences." }
          }
        },
        "hard_requirements_match": {
          "type": "object",
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 30 },
            "coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "details": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "requirement": { "type": "string" },
                  "status": { "type": "string", "enum": ["exact", "strong", "partial", "weak", "missing"] },
                  "evidence": { "type": "string", "description": "ONE quote fragment with role+year, <=25 words, or 'MISSING: <requirement>'." }
                }
              }
            }
          }
        },
        "nice_to_haves_differentiation": {
          "type": "object",
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 20 },
            "assessment": { "type": "string", "description": "<=2 sentences." }
          }
        },
        "overall_fit_recommendation": {
          "type": "object",
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 10 },
            "red_flags": { "type": "array", "maxItems": 5, "items": { "type": "string" } },
            "green_flags": { "type": "array", "maxItems": 5, "items": { "type": "string" } }
          }
        }
      }
    },
    "total_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "recommendation": {
      "type": "string",
      "enum": ["READY_FOR_SUBMISSION", "NEEDS_TAILORING", "WEAK_MATCH"]
    },
    "strengths": { "type": "array", "maxItems": 5, "items": { "type": "string" } },
    "critical_issues": { "type": "array", "maxItems": 5, "items": { "type": "string" } },
    "priority_fixes": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "issue": { "type": "string" },
          "impact_on_score": { "type": "integer" },
          "effort": { "type": "string", "enum": ["quick", "medium", "hard"] },
          "actionable_fix": { "type": "string" }
        }
      }
    },
    "tailoring_suggestions": {
      "type": "array",
      "maxItems": 5,
      "description": "Omit entirely when total_score >= 75.",
      "items": {
        "type": "object",
        "properties": {
          "section": { "type": "string" },
          "suggestion": { "type": "string" },
          "estimated_point_gain": { "type": "integer" }
        }
      }
    }
  }
}
